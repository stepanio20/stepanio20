# Copy to .env (gitignored) and fill in. Never commit real secrets.

# Required — from @BotFather
TELEGRAM_BOT_TOKEN=

# Payments — veym gateway (MamoPay-backed, AED). Same gateway as the Dubai Unit Bot.
VEYM_API_KEY=                 # veym `apikey` (used for GET /v1/payments, /:id, /v1/webhooks)
VEYM_BASE_URL=https://veym.up.railway.app/v1
VEYM_WEBHOOK_SECRET=          # the `authorization` value veym sends to /mamopay-webhook
MAMO_API_KEY=                 # MamoPay merchant key that CREATES the hosted charge (from the Dubai bot)
MAMO_BASE_URL=https://business.mamopay.com/manage_api/v1
CURRENCY=AED

# Public HTTPS base (Railway domain) — for the /mamopay-webhook + return URLs
PUBLIC_BASE_URL=              # e.g. https://diamondscan.up.railway.app
PORT=8080                     # Railway injects this automatically

# Testing switch — reveals counterparty contact WITHOUT a paid subscription.
# Set true to demo the full loop; MUST be false in production.
FREE_REVEAL=false

# Optional integrations
GIA_API_KEY=                  # GIA Report Results API — cert verification ($0.20/lookup)
ANTHROPIC_API_KEY=            # optional LLM fallback parser (regex works without it)

# Ingestion — BYO-session Telegram reader (optional; see login.py)
TG_API_ID=                    # from https://my.telegram.org  (apps)
TG_API_HASH=
TG_SESSION=                   # StringSession produced by `python login.py`

# Runtime
MARKET=dubai
TELEGRAM_CHANNEL_ID=          # channel to publish verified deal cards to (bot must be admin)
ADMIN_USER_IDS=               # comma-separated Telegram user IDs with /status,/publish
CONTACT_PHONE=+971 56 000 0000
BOT_USERNAME=DiamondScanBot
DATABASE_PATH=diamond_bot.db
