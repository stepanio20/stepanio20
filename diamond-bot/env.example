# Copy to .env (gitignored) and fill in. Never commit real secrets.

# Required — from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional integrations
GIA_API_KEY=              # GIA Report Results API — cert verification ($0.20/lookup)
ANTHROPIC_API_KEY=        # optional LLM fallback parser (regex works without it)
TELEGRAM_PROVIDER_TOKEN=  # fiat card payments; leave empty to use Telegram Stars

# Runtime
MARKET=dubai
TELEGRAM_CHANNEL_ID=      # channel to publish verified deal cards to (bot must be admin)
ADMIN_USER_IDS=           # comma-separated Telegram user IDs with /status,/publish
CONTACT_PHONE=+971 56 000 0000
BOT_USERNAME=DiamondScanBot
DATABASE_PATH=diamond_bot.db
