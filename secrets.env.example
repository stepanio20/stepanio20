# Concierge — secrets template
# Copy this file to `secrets.env`, fill in the bits you have, and run
# `source secrets.env` (the connectors read os.environ directly).
# Never commit secrets.env — it's already gitignored.

# --- Whoop ----------------------------------------------------------------- #
# Get these at https://developer.whoop.com/dashboard
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Redirect URI must EXACTLY match the one you registered on the dashboard.
WHOOP_REDIRECT_URI=http://localhost:8910/callback
# Where authorize.py writes the refresh token after the OAuth dance.
WHOOP_TOKEN_PATH=secrets/whoop_token.json

# --- Google Calendar ------------------------------------------------------- #
# Path to the OAuth client JSON downloaded from https://console.cloud.google.com/apis/credentials
GCAL_OAUTH_JSON=secrets/gcal_oauth.json
GCAL_TOKEN_PATH=secrets/gcal_token.json
# Name of the Concierge calendar to create on first push.
GCAL_CALENDAR_NAME=Concierge

# --- Oura (optional alternative to Whoop) ---------------------------------- #
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8911/callback
OURA_TOKEN_PATH=secrets/oura_token.json
